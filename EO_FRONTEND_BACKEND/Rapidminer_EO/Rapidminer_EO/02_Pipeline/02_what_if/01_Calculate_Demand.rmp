              <parameter key="error_category" value="if(contains(lower(%{error}),lower(&quot;database&quot;)),&quot;Database&quot;,&#10;if(contains(lower(%{error}),lower(&quot;failed with: HTTP code 401&quot;))&#10;||contains(lower(%{error}),lower(&quot;HTTP code 503&quot;))&#10;||contains(lower(%{error}),lower(&quot;Failed to lookup data item&quot;))&#10;||contains(lower(%{error}),lower(&quot;data set contains columns of different lengths&quot;))&#10;||contains(lower(%{error}),lower(&quot;operator failed to establish communication with the PI Web API&quot;))&#10;||contains(lower(%{error}),lower(&quot;pi data lagging:&quot;))&#10;,&quot;PI&quot;,&quot;Pipeline&quot;))"/>
              <parameter key="error_detail" value="cut(%{error},0,min(length(%{error}),995))"/>
