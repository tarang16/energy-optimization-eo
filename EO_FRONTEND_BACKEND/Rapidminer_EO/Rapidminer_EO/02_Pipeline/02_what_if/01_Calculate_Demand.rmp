                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (7)" width="90" x="45" y="544">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select [model_id],&#10;[tag_id],&#10;[time_stamp],&#10;[actual],&#10;[optimum],&#10;[design],&#10;[current]&#10;from dbo.model_Output  &#10;where model_id = %{model_id} and time_stamp = (select max(last_run_time) as last_sucessful_time  from (select * from Run_Info  where (model_status = 'on' or model_status = 'on_default')  and model_id =%{model_id} and last_run_time &lt;= '%{time_stamp}') as rn)&#10;"/>
