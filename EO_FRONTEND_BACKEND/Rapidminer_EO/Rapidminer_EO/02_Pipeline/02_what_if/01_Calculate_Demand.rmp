                  </operator>
                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (23)" width="90" x="45" y="340">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select sub_model_id, t.tag_name,mt.model_tag_id,sub_model_expression,sub_model_name,sub_model_type,algorithm,sb.&quot;order&quot;,response_output&#10;from dbo.sub_model sb&#10;join dbo.model_tag mt&#10;on mt.model_tag_id = sb.target_model_tag_id&#10;join dbo.tag t&#10;on mt.tag_id = t.tag_id&#10;where model_id = %{model_id} and sb.active = 1&#10;"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="false"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                  </operator>
