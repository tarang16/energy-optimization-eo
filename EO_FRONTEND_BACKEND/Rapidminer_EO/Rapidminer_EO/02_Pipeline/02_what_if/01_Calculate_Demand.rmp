                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (26)" width="90" x="45" y="442">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select sub_model_id, tag_name&#10;from dbo.sub_model_child sb&#10;join dbo.model_tag mt&#10;on mt.model_tag_id = sb.child_model_tag_id&#10;join dbo.tag t&#10;on mt.tag_id = t.tag_id&#10;where model_id = %{model_id} and sb.active = 1 and flag_sub_model_input = 1&#10;"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="false"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
