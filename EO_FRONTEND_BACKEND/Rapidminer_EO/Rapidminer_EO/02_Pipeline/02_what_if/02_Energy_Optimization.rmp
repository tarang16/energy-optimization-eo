                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (88)" width="90" x="246" y="595">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select obj.model_tag_id,obj.direction FROM dbo.objective obj&#10;INNER JOIN dbo.model_tag mt&#10;ON obj.model_tag_id=mt.model_tag_id&#10;WHERE model_id=%{model_id} and obj.active=1 and mt.active=1"/>
