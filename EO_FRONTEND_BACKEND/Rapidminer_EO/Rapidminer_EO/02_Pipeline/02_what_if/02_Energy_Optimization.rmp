                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (55)" width="90" x="1385" y="493">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select mo.tag_id,mo.optimum, mt.model_tag_id,t.tag_name, mo.time_stamp&#10;from &quot;dbo&quot;.&quot;tag&quot; t&#10;INNER JOIN &quot;dbo&quot;.&quot;model_tag&quot; mt ON mt.tag_id = t.tag_id&#10;LEFT JOIN &quot;dbo&quot;.&quot;model_output&quot; mo ON t.tag_id = mo.tag_id&#10;where mt.model_id = %{model_id} and time_stamp = (select max(last_run_time) as last_sucessful_time  from (select * from &quot;dbo&quot;.&quot;run_info&quot;  where (model_status = 'on' or model_status = 'on_default')  and model_id =%{model_id} and last_run_time &lt;= '%{time_stamp}') as rn)"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="table_name" value="case"/>
                    <parameter key="prepare_statement" value="true"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
