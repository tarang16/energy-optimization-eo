            <description align="center" color="transparent" colored="false" width="126">Branch condition model_status = 1&lt;br&gt;Calculate bill/benefit tags, prepare output in required format&lt;br&gt;&lt;br&gt;I/P 1: model_status&lt;br&gt;I/P 2: Optimum data&lt;br&gt;I/P 3: Actual data&lt;br&gt;&lt;br&gt;O/P : Output data</description>
          </operator>
          <connect from_port="in 1" to_op="api_inputs" to_port="in 1"/>
