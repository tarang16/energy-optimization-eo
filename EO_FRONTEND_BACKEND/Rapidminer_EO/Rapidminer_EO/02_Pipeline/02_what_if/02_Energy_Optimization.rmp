                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (81)" width="90" x="246" y="187">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select mp.* FROM model_parameter mp&#10;INNER JOIN model_version mv&#10;ON mp.model_version_id=mv.model_version_id&#10;INNER JOIN model m&#10;ON mv.model_id=m.model_id&#10;WHERE m.model_id=%{model_id} and m.active=1 and mv.active=1 and mp.active=1"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="false"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                  </operator>
                  <operator activated="true" class="remember" compatibility="10.0.000" expanded="true" height="68" name="model_parameter (2)" width="90" x="380" y="187">
                    <parameter key="name" value="model_parameter"/>
                    <parameter key="io_object" value="ExampleSet"/>
