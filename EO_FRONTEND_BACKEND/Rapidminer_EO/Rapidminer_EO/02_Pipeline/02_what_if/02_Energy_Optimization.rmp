                      <operator activated="true" class="handle_exception" compatibility="10.4.003" expanded="true" height="166" name="Handle Exception (11)" width="90" x="313" y="34">
                        <parameter key="add_details_to_log" value="false"/>
                        <process expanded="true">
                          <operator activated="true" class="python_scripting:execute_python" compatibility="10.1.002" expanded="true" height="187" name="Execute Python (2)" width="90" x="112" y="34">
                            <parameter key="script" value="from gekko import GEKKO&#10;import pandas as pd&#10;import numpy as np&#10;import json&#10;#Initialize Model&#10; &#10;def rm_main(options_df: pd.DataFrame, param_df: pd.DataFrame, var_df: pd.DataFrame, constraint_df: pd.DataFrame, optimizer_df: pd.DataFrame):&#10;    &quot;&quot;&quot;&#10;    Run an optimization problem using GEKKO. It takes in several DataFrames containing the problem definition and returns a DataFrame containing the results and run status.&#10; &#10;    Parameters&#10;    ----------&#10;    options_df : pd.DataFrame&#10;        DataFrame containing solver options.&#10;    param_df : pd.DataFrame&#10;        DataFrame containing parameter values.&#10;    var_df : pd.DataFrame&#10;        DataFrame containing variable definitions.&#10;    constraint_df : pd.DataFrame&#10;        DataFrame containing constraint equations.&#10;    optimizer_df : pd.DataFrame&#10;        DataFrame containing optimizer equations.&#10; &#10;    Returns&#10;    -------&#10;    pd.DataFrame&#10;        DataFrame containing the optimization results and model run status&#10;    &quot;&quot;&quot;&#10;    try:&#10;    # Setting block name and initial status&#10;        block_name = 'python optimizer'&#10;        status, remarks = 1, 'successful'&#10;    &#10;        # Create copies of the input DataFrames to avoid modifying the originals&#10;        params_copy = param_df.copy()&#10;        vars_copy = var_df.copy()&#10;        constraint_copy = constraint_df.copy()&#10;        optimizer_copy = optimizer_df.copy()&#10;        solver_copy = options_df.copy()&#10;    &#10;        # Initialize GEKKO&#10;        m = GEKKO(remote=False)&#10;        m.options.SOLVER = 1  # APOPT is an MINLP solver&#10;    &#10;        # Optional solver settings with APOPT (reduced iterations)&#10;        solver_copy['options'] = solver_copy['parameter'].astype(str) + ' ' + solver_copy['value'].astype(str)&#10;        m.solver_options = solver_copy['options'].to_list()&#10;    &#10;        # Define parameters&#10;        if not params_copy.empty:&#10;            params_dict = {}&#10;            for i, row in params_copy.iterrows():&#10;                # Create a GEKKO parameter for each row in the DataFrame&#10;                params_dict[row['tag_name']] = m.Param(value=row['value'])&#10;            # Update the local namespace with the parameter names&#10;            locals().update(params_dict)&#10;        &#10;        # Define variables&#10;        if not vars_copy.empty:&#10;            # Rename columns to match GEKKO's variable attributes&#10;            rename_dict = {'is_integer': 'integer', 'upper_bound': 'ub',&#10;                        'lower_bound': 'lb', 'value': 'value'}&#10;            vars_copy.rename(columns=rename_dict, inplace=True)&#10;            vars_dict = {}&#10;            for i, row in vars_copy.iterrows():&#10;                # Create a GEKKO variable for each row in the DataFrame&#10;                vars_attrs = {&#10;                    'value': row['value'],&#10;                    **{att: row[att] for att in ['lb', 'ub', 'integer'] if not np.isnan(row[att])}&#10;                }&#10;                vars_dict[row['tag_name']] = m.Var(**vars_attrs)&#10;            # Update the local namespace with the variable names&#10;            locals().update(vars_dict)&#10;    &#10;        # Define constraints&#10;        for i, row in constraint_copy.iterrows():&#10;            # Parse the constraint equation and add it to the model&#10;            parsed_eq = eval(row['expr'])&#10;            m.Equation(parsed_eq)&#10;        &#10;        # Define optimizers&#10;        for i, row in optimizer_copy.iterrows():&#10;            # Parse the optimizer equation and add it to the model&#10;            parsed_eq = eval(row['expr'])&#10;            m.Obj(parsed_eq)&#10;    &#10;        # Solve the optimization problem&#10;    &#10;        m.solve(disp=True)&#10;    except Exception as ex:&#10;        status, remarks = 0, repr(ex)&#10;    &#10;    # Create a DataFrame to store the run status&#10;    run_status = pd.DataFrame({&#10;        'block_name': [block_name],&#10;        'status': [status],&#10;        'remarks': [remarks]&#10;       })&#10; &#10;    if status:&#10;        # Create a DataFrame to store the results&#10;        results = {&#10;            'variable': ['Objective'],&#10;            'value': [m.options.objfcnval]&#10;        }&#10;   &#10;        # Add variable values to the results DataFrame&#10;        for i, row in vars_copy.iterrows():&#10;            results['variable'].append(row['tag_name'])&#10;            results['value'].extend(locals().get(row['tag_name']).value)  &#10;           &#10;        # Return the results DataFrame&#10;        return run_status, pd.DataFrame(results).round(decimals=3)&#10; &#10;    else:&#10;        return run_status"/>
