                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (87)" width="90" x="246" y="391">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select model_tag_id,&#10;model_id,&#10;mt.tag_id,&#10;flag_parameter,&#10;flag_ma,&#10;flag_ma_filter,&#10;flag_data_available_check,&#10;flag_output,&#10;flag_output_run_always,&#10;design_expression,&#10;polarity_expression,&#10;tag_name&#10;FROM dbo.model_tag mt&#10;INNER JOIN dbo.tag t&#10;ON mt.tag_id=t.tag_id&#10;WHERE model_id=%{model_id} and mt.active=1 and t.active=1"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="false"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                  </operator>
                  <operator activated="true" class="remember" compatibility="10.0.000" expanded="true" height="68" name="model_tag (2)" width="90" x="380" y="391">
                    <parameter key="name" value="model_tag"/>
                    <parameter key="io_object" value="ExampleSet"/>
