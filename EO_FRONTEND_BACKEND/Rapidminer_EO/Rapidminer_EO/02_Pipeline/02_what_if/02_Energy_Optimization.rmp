                  </operator>
                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (45)" width="90" x="246" y="289">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="SELECT mt.model_tag_id,mt.tag_id,t.tag_name,t.tag_type,t.data_type&#10;FROM &quot;dbo&quot;.&quot;model&quot; m&#10;INNER JOIN &quot;dbo&quot;.&quot;model_tag&quot; mt ON m.model_id = mt.model_id&#10;INNER JOIN &quot;dbo&quot;.&quot;tag&quot; t ON mt.tag_id = t.tag_id&#10;WHERE m.model_id = %{model_id} AND t.active = 1 and mt.active=1 &#10;"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="false"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                  </operator>
                  <operator activated="true" class="remember" compatibility="10.0.000" expanded="true" height="68" name="tags" width="90" x="380" y="289">
