          <connect from_op="loader (2)" from_port="out 1" to_op="merge data" to_port="in 1"/>
          <connect from_op="merge data" from_port="out 1" to_op="optimizer model" to_port="in 1"/>
          <connect from_op="optimizer model" from_port="out 1" to_op="post optimizer" to_port="condition"/>
          <connect from_op="optimizer model" from_port="out 2" to_op="post optimizer" to_port="input 1"/>
          <connect from_op="optimizer model" from_port="out 3" to_op="post optimizer" to_port="input 2"/>
