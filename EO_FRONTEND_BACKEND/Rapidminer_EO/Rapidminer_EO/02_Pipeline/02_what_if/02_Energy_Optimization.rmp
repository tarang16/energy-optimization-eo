                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (5)" width="90" x="849" y="493">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="select mpm.macro_name as parameter,mpm.default_value,pm.category,pm.value from mst_pipeline_macros mpm &#10;join pipeline_macros pm&#10;on mpm.mst_pipeline_macro_id = pm.mst_pipeline_macro_id&#10;where model_id = %{model_id} and  mpm.active = 1 and pm.active = 1"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="table_name" value="case"/>
                    <parameter key="prepare_statement" value="true"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                  </operator>
                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (3)" width="90" x="246" y="799">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="SELECT mt.model_tag_id,mt.tag_id,t.tag_name,t.tag_type,t.data_type,v.formula_expression,b.rm_block_name&#10;FROM &quot;dbo&quot;.&quot;model&quot; m&#10;INNER JOIN &quot;dbo&quot;.&quot;model_tag&quot; mt ON m.model_id = mt.model_id&#10;INNER JOIN &quot;dbo&quot;.&quot;tag&quot; t ON mt.tag_id = t.tag_id&#10;left JOIN &quot;dbo&quot;.&quot;inferred_details&quot; v ON mt.model_tag_id = v.model_tag_id&#10;left join &quot;dbo&quot;.&quot;inferred_tag_rm_block_mapping&quot; tbm ON v.inferred_detail_id = tbm.inferred_detail_id&#10;left join &quot;dbo&quot;.&quot;rm_blocks&quot; b ON tbm.rm_block_id = b.rm_block_id&#10;WHERE m.model_id = %{model_id} AND t.active = 1 and v.active=1 and mt.active=1 and tbm.active = 1 and b.rm_block_name = 'whatif_inferred'"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="false"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                  </operator>
