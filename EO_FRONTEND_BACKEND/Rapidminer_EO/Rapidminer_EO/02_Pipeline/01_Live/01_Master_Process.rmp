                  <parameter key="time_slot" value="parse(%{flag_number})/15"/>
                  <parameter key="time_slot" value="if(parse(%{time_slot})%1&gt;0,parse(%{time_slot})+1,rint(parse(%{time_slot})+1))"/>
                  <parameter key="time_slot_flag" value="parse(%{time_slot})%1"/>
                  <parameter key="current_slot" value="floor(parse(%{time_slot}))"/>
                  <parameter key="schedule_hour" value="date_str_custom(date_set(date_set(date_now(),00,DATE_UNIT_MINUTE),00,DATE_UNIT_SECOND),&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
