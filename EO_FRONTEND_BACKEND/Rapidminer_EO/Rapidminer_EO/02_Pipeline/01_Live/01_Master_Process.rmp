          <portSpacing port="sink_input 1" spacing="0"/>
          <description align="center" color="green" colored="true" height="362" resized="false" width="239" x="161" y="16"/>
        </process>
      </operator>
      <connect from_op="Token / Initialisation (2)" from_port="out 1" to_op="Fetch Jobs/Kill jobs" to_port="in 1"/>
      <connect from_op="Fetch Jobs/Kill jobs" from_port="out 1" to_op="Schedules (3)" to_port="condition"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <description align="center" color="red" colored="true" height="654" resized="true" width="189" x="257" y="66">Input Macros</description>
      <description align="center" color="purple" colored="true" height="653" resized="true" width="170" x="478" y="69">API Token Service&lt;br&gt;Initialisation</description>
      <description align="center" color="orange" colored="true" height="650" resized="true" width="182" x="677" y="72">Fetch Jobs&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;This step contains 3 tasks.&lt;br&gt;1. Get all pending master jobs from AIHUB using GET(REST) query and to kill them&lt;br&gt;2. Get all Running/Pending jobs from AI HUB using GET (REST) query.&lt;br&gt;Check if they are run_time is more than 45min and kill the jobs accordingly&lt;br&gt;&lt;br&gt;3. update start time and end_time of recently finished jobs into scheduler table&lt;br&gt;&lt;br&gt;</description>
      <description align="center" color="green" colored="true" height="653" resized="true" width="233" x="902" y="68">Schedules&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;This step contains 2 tasks.&lt;br&gt;&lt;br&gt;Check if Slot_triggered_flag,&lt;br&gt;if Slot_triggered_flag==1 (i.e atleast one case of current slot has been already triggered in current hour) OR 'case_exists_in_current_slot' ==0 (i.e. no case is listed to run in current slot),then check the no of available aihub containers, if available , then POST jobs of cases which need backfilling.&lt;br&gt;&lt;br&gt;Else,&lt;br&gt;POST jobs of all cases from current slot (removing running/pending cases from it)&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;</description>
      <description align="center" color="blue" colored="true" height="647" resized="true" width="208" x="22" y="70">Master Process Pipeline&lt;br&gt;&lt;br&gt;This is process is cron scheduled to run every 5 mins&lt;br&gt;&lt;br&gt;&lt;br&gt;Author&lt;br&gt;Karthik Venkata&lt;br&gt;Naveen Kumar&lt;br&gt;Shankhadeep Gharai&lt;br&gt;Arshnoor Khan&lt;br&gt;&lt;br&gt;Our master process architecture comprises two key components:&lt;br&gt;1. Populating the data for different case_ids in slots :&lt;br&gt;&amp;#8226; All cases has been divided into 4 slots&lt;br&gt;&lt;br&gt;2. Utilising the free when no processes are running and free slots are available to backfill the data for different cases..&lt;br&gt;&lt;br&gt;</description>
    </process>
  </operator>
</process>
