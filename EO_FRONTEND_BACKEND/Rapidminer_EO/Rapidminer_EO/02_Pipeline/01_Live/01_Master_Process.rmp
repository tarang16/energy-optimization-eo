                    <list key="function_descriptions">
                      <parameter key="back_fill_time" value="date_diff([last_run_time],date_parse_custom(%{process_start},&quot;yyyy_MM_dd-a_hh_mm_ss&quot;))/(1000*60)"/>
                      <parameter key="case_trigger_flag" value="if([back_fill_time]&gt;60,0,1)"/>
                      <parameter key="last_run_time" value="date_str_custom([last_run_time],&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
                    </list>
                    <parameter key="keep_all" value="true"/>
                    <description align="center" color="transparent" colored="false" width="126">Calculate the backfilling time (how behind the last_run_time is from current process_time) in mins&lt;br&gt;&lt;br&gt;&lt;br&gt;</description>
                  </operator>
