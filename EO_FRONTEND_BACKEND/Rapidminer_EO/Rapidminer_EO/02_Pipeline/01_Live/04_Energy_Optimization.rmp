                          <parameter key="value_category" value="if(ends([tag_name],&quot;_actual&quot;),&quot;actual&quot;,&#10;if(ends([tag_name],&quot;_optimum&quot;),&quot;optimum&quot;,if(ends([tag_name],&quot;_polarity&quot;),&quot;polarity&quot;,&#10;if(ends([tag_name],&quot;_design&quot;),&quot;design&quot;,&#10;if(ends([tag_name],&quot;_current&quot;),&quot;current&quot;,&quot;actual&quot;)))))"/>
                          <parameter key="tag_name" value="if(ends([tag_name],&quot;_actual&quot;),replace([tag_name],&quot;_actual&quot;,&quot;&quot;),&#13;&#10;if(ends([tag_name],&quot;_optimum&quot;),replace([tag_name],&quot;_optimum&quot;,&quot;&quot;),&#13;&#10;if(ends([tag_name],&quot;_polarity&quot;),replace([tag_name],&quot;_polarity&quot;,&quot;&quot;),&#13;&#10;if(ends([tag_name],&quot;_design&quot;),replace([tag_name],&quot;_design&quot;,&quot;&quot;),&#13;&#10;if(ends([tag_name],&quot;_current&quot;),replace([tag_name],&quot;_current&quot;,&quot;&quot;),[tag_name])))))"/>
                        </list>
                        <parameter key="keep_all_columns" value="true"/>
                        <parameter key="default_time_zone" value="Asia/Calcutta"/>
