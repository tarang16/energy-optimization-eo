                        <parameter key="define_query" value="query"/>
                        <parameter key="query" value="SELECT tgd.model_id,tgd.tag_id,tgd.last_good_value, mt.model_tag_id,t.tag_name,t.tag_type,t.data_type,TRIM(t.pi_name) as pi_name&#10;FROM &quot;dbo&quot;.&quot;tag&quot; t&#10;INNER JOIN &quot;dbo&quot;.&quot;model_tag&quot; mt ON mt.tag_id = t.tag_id&#10;LEFT JOIN &quot;dbo&quot;.&quot;tag_good_data&quot; tgd ON tgd.tag_id = t.tag_id&#10;where mt.model_id=%{model_id} and t.active = 1 and mt.active=1"/>
                        <parameter key="use_default_schema" value="true"/>
