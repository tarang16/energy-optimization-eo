                      <operator activated="true" class="branch" compatibility="10.4.003" expanded="true" height="103" name="Branch (15)" width="90" x="715" y="34">
                        <parameter key="condition_type" value="expression"/>
                        <parameter key="expression" value="if(%{flag_retry}==1 &amp;&amp; eval(%{nEX})&gt;1,1,0)"/>
                        <parameter key="io_object" value="ANOVAMatrix"/>
                        <parameter key="return_inner_output" value="true"/>
                        <process expanded="true">
                          <operator activated="true" class="subprocess" compatibility="10.4.003" expanded="true" height="68" name="Subprocess (10)" width="90" x="246" y="136">
                            <process expanded="true">
                              <operator activated="true" class="generate_macro" compatibility="10.4.003" expanded="true" height="82" name="re iterate" width="90" x="45" y="34">
                                <list key="function_descriptions">
                                  <parameter key="nEX" value="eval(%{nEX})-1"/>
                                </list>
