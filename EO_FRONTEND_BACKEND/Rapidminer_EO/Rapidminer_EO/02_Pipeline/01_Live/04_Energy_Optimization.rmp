                    <list key="function_descriptions">
                      <parameter key="time_end" value="date_str_custom(date_add(date_parse_custom(%{end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),rint(parse(%{hour_value})),DATE_UNIT_HOUR),&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
                      <parameter key="time_start" value="date_str_custom(date_add(date_parse_custom(%{end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),rint((-1)*parse(%{SEU_relaxed_time_in_hrs})),DATE_UNIT_HOUR),&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
                    </list>
                    <description align="center" color="transparent" colored="false" width="126">gen macros for start time, end time, time diff</description>
                  </operator>
                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (43)" width="90" x="648" y="34">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_peeo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="WITH RankedRows AS (&#10;    SELECT &#10;        lbm_model_id as model_id, &#10;        run_time as peeo_actual_time, &#10;        optimum_time as peeo_optimum_time,&#10;        ROW_NUMBER() OVER (PARTITION BY lbm_model_id ORDER BY run_time desc) AS rn&#10;    FROM Optimum_Time_Data&#10;    WHERE optimum_time IS NOT NULL  and lbm_model_id IN (%{model_id_list}) and run_time &lt;='%{time_end}' and run_time &gt;= '%{time_start}'&#10;)&#10;SELECT model.case_id,RR.model_id, peeo_actual_time, peeo_optimum_time&#10;FROM RankedRows RR&#10;Left JOIn model&#10;on RR.model_id=model.model_id&#10;"/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="false"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                    <description align="center" color="transparent" colored="false" width="126">Retrieves latest run time for each model_id from optimum time data for given end time. Extracting peeo actual time, optimum time for particular case and model id</description>
                  </operator>
