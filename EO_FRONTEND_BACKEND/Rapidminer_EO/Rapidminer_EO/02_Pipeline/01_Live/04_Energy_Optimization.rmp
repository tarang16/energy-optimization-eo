                        <parameter key="define_query" value="query"/>
                        <parameter key="query" value="select mo.tag_id,mo.optimum, mt.model_tag_id,mt.tag_id,t.tag_name,t.tag_type,t.data_type,TRIM(t.pi_name) as pi_name&#10;from &quot;dbo&quot;.&quot;tag&quot; t&#10;INNER JOIN &quot;dbo&quot;.&quot;model_tag&quot; mt ON mt.tag_id = t.tag_id&#10;LEFT JOIN &quot;dbo&quot;.&quot;model_output&quot; mo ON t.tag_id = mo.tag_id&#10;where mt.model_id = %{model_id} and time_stamp = (select max(last_run_time) as last_sucessful_time  from (select * from &quot;dbo&quot;.&quot;run_info&quot;  where (model_status = 'on' or model_status = 'on_default')  and model_id =%{model_id} and last_run_time &lt;= '%{end_time}') as rn)"/>
                        <parameter key="use_default_schema" value="true"/>
                        <parameter key="table_name" value="case"/>
                        <parameter key="prepare_statement" value="true"/>
                        <enumeration key="parameters"/>
                        <parameter key="data_management" value="auto"/>
