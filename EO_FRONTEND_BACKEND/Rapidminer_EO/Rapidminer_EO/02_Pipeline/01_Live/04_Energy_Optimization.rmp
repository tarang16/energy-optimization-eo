                      </operator>
                      <operator activated="true" class="generate_macro" compatibility="10.4.003" expanded="true" height="82" name="File not found?" width="90" x="581" y="187">
                        <list key="function_descriptions">
                          <parameter key="flag_retry" value="if(contains(%{remarks},&quot;successful&quot;),0,1)"/>
