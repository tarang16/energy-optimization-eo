                  <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (12)" width="90" x="179" y="391">
                    <parameter key="define_connection" value="repository"/>
                    <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                    <parameter key="database_system" value="MySQL"/>
                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="WITH RankedVersions AS (&#10;&#10;    SELECT &#10;&#10;        smv.sub_model_version_id,&#10;&#10;        smv.sub_model_id,&#10;&#10;        ROW_NUMBER() OVER (PARTITION BY smv.sub_model_id ORDER BY smv.sub_model_version DESC) AS rn&#10;&#10;    FROM sub_model_version smv&#10;&#10;    WHERE smv.active = 1&#10;&#10;)&#10;&#10;SELECT &#10;&#10;    rv.sub_model_id,&#10;&#10;    rv.sub_model_version_id,&#10;&#10;    m.case_id,&#10;&#10;    m.model_id&#10;&#10;FROM RankedVersions rv&#10;&#10;INNER JOIN sub_model sm &#10;&#10;    ON rv.sub_model_id = sm.sub_model_id&#10;&#10;INNER JOIN model_tag mt &#10;&#10;    ON sm.target_model_tag_id = mt.model_tag_id&#10;&#10;INNER JOIN model m &#10;&#10;    ON mt.model_id = m.model_id&#10;&#10;WHERE rv.rn = 1;&#10;&#10; "/>
                    <parameter key="use_default_schema" value="true"/>
                    <parameter key="prepare_statement" value="true"/>
                    <enumeration key="parameters"/>
                    <parameter key="data_management" value="auto"/>
                    <description align="center" color="transparent" colored="false" width="126">Red sub_model_&lt;br/&gt;version</description>
