                        <parameter key="define_query" value="query"/>
                        <parameter key="query" value="select TOP(1) last_run_time&#10;FROM run_info&#10;INNER JOIN model &#10;ON run_info.model_id=model.model_id&#10;WHERE model.case_id  = %{case_id}&#10;ORDER BY last_run_time desc"/>
