          <description align="center" color="green" colored="true" height="385" resized="true" width="370" x="68" y="10">Initialization Stage&lt;br&gt;Read tables, make pi and sql connections and generate trigger specific macros</description>
          <description align="center" color="blue" colored="true" height="377" resized="true" width="292" x="679" y="17">MAIN&lt;br&gt;execute Retraining pipeline for next retraning time</description>
          <description align="center" color="red" colored="true" height="380" resized="true" width="238" x="441" y="12">Delete AIhUB job, update scheduler</description>
        </process>
        <process expanded="true">
          <operator activated="true" class="branch" compatibility="10.4.003" expanded="true" height="82" name="Branch (5)" width="90" x="45" y="34">
            <parameter key="condition_type" value="macro_defined"/>
            <parameter key="condition_value" value="model_id"/>
            <parameter key="expression" value=""/>
            <parameter key="io_object" value="ANOVAMatrix"/>
            <parameter key="return_inner_output" value="true"/>
            <process expanded="true">
              <portSpacing port="source_condition" spacing="0"/>
              <portSpacing port="source_input 1" spacing="0"/>
              <portSpacing port="sink_input 1" spacing="0"/>
            </process>
            <process expanded="true">
              <operator activated="true" class="set_macro" compatibility="10.4.003" expanded="true" height="68" name="Set Macro" width="90" x="112" y="85">
                <parameter key="macro" value="model_id"/>
                <parameter key="value" value="0"/>
                <description align="center" color="transparent" colored="false" width="126">model_id = 0</description>
              </operator>
              <portSpacing port="source_condition" spacing="0"/>
              <portSpacing port="source_input 1" spacing="0"/>
              <portSpacing port="sink_input 1" spacing="0"/>
            </process>
          </operator>
          <operator activated="true" breakpoints="after" class="utility:create_exampleset" compatibility="10.4.003" expanded="true" height="68" name="Create ExampleSet (2)" width="90" x="246" y="34">
            <parameter key="generator_type" value="attribute functions"/>
            <parameter key="number_of_examples" value="1"/>
            <parameter key="use_stepsize" value="false"/>
            <list key="function_descriptions">
              <parameter key="model_id" value="%{model_id}"/>
              <parameter key="time_stamp" value="date_now()"/>
              <parameter key="error_subprocess" value="cut(%{block},0,min(length(%{block}),495))"/>
              <parameter key="error_category" value="if(contains(lower(%{error}),lower(&quot;database&quot;)),&quot;Database&quot;,&#10;if(contains(lower(%{error}),lower(&quot;failed with: HTTP code 401&quot;))&#10;||contains(lower(%{error}),lower(&quot;HTTP code 503&quot;))&#10;||contains(lower(%{error}),lower(&quot;Failed to lookup data item&quot;))&#10;||contains(lower(%{error}),lower(&quot;data set contains columns of different lengths&quot;))&#10;||contains(lower(%{error}),lower(&quot;operator failed to establish communication with the PI Web API&quot;))&#10;||contains(lower(%{error}),lower(&quot;pi data lagging&quot;))&#10;,&quot;PI&quot;,&quot;Pipeline&quot;))"/>
              <parameter key="error_detail" value="cut(%{error},0,min(length(%{error}),995))"/>
              <parameter key="error_process_name" value="lower(%{process_name})"/>
            </list>
            <parameter key="add_id_attribute" value="false"/>
            <list key="numeric_series_configuration"/>
            <list key="date_series_configuration"/>
            <list key="date_series_configuration (interval)"/>
            <parameter key="date_format" value="yyyy-MM-dd HH:mm:ss"/>
            <parameter key="time_zone" value="SYSTEM"/>
            <parameter key="input_csv_text" value="block,error&#10;%{block},%{error}"/>
            <parameter key="column_separator" value=","/>
            <parameter key="parse_all_as_nominal" value="false"/>
            <parameter key="decimal_point_character" value="."/>
            <parameter key="trim_attribute_names" value="true"/>
            <description align="center" color="transparent" colored="false" width="126">model_id&lt;br&gt;time_stamp&lt;br&gt;error_process_name&lt;br/&gt;error_subprocess&lt;br/&gt;error_category</description>
          </operator>
          <operator activated="true" class="jdbc_connectors:write_database" compatibility="10.4.003" expanded="true" height="82" name="Write Database" width="90" x="380" y="34">
            <parameter key="define_connection" value="repository"/>
            <parameter key="connection_entry" value="%{connection_sql_eo}"/>
            <parameter key="database_system" value="MySQL"/>
            <parameter key="use_default_schema" value="true"/>
            <parameter key="table_name" value="error_log"/>
            <parameter key="overwrite_mode" value="append"/>
            <parameter key="set_default_varchar_length" value="false"/>
            <parameter key="default_varchar_length" value="128"/>
            <parameter key="add_generated_primary_keys" value="false"/>
            <parameter key="db_key_attribute_name" value="generated_primary_key"/>
            <parameter key="batch_size" value="100"/>
            <description align="center" color="transparent" colored="false" width="126">write to error_log</description>
          </operator>
          <connect from_op="Create ExampleSet (2)" from_port="output" to_op="Write Database" to_port="input"/>
          <portSpacing port="source_in 1" spacing="0"/>
          <portSpacing port="sink_out 1" spacing="0"/>
          <portSpacing port="sink_out 2" spacing="0"/>
        </process>
      </operator>
      <connect from_op="Handle Exception" from_port="out 1" to_port="result 1"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
      <description align="center" color="red" colored="true" height="398" resized="true" width="250" x="22" y="138">Trigger service Retraining and validation&lt;br&gt;&lt;br&gt;&lt;br&gt;Author:&lt;br&gt;Naveen kumar&lt;br&gt;Akshay Hasabe&lt;br&gt;&lt;br&gt;Overview:This Pipeline is scheduled every 15 mins, it will execute retraining validaiton of sub model by checking the corresponding history tables and frequencies.&lt;br&gt;</description>
      <description align="center" color="green" colored="true" height="398" resized="true" width="283" x="277" y="141">TRIGGER RETRAINING AND VALIDATION</description>
    </process>
  </operator>
</process>
