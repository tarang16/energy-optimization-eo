                          <parameter key="date_diff_available_pi_retraining_end_time" value="rint(date_diff(date_parse_custom(%{retraining_end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),date_parse_custom(%{available_pi_time},&quot;yyyy-MM-dd HH:mm:ss&quot;)))/(1000*60*60*24)"/>
