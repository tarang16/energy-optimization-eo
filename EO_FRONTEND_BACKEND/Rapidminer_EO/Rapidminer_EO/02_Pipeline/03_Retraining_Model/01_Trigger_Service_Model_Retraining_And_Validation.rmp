                    <parameter key="define_query" value="query"/>
                    <parameter key="query" value="SELECT smp.sub_model_version_id, msmp.parameter_name as parameter, smp.value&#10;FROM &quot;dbo&quot;.&quot;sub_model_parameter&quot; smp&#10;inner join &quot;dbo&quot;.&quot;mst_sub_model_parameter&quot; msmp&#10;on smp.mst_sub_model_parameter_id = msmp.mst_sub_model_parameter_id&#10;where smp.active = 1 "/>
