                      <operator activated="true" class="jdbc_connectors:read_database" compatibility="10.4.003" expanded="true" height="82" name="Read Database (16)" width="90" x="179" y="34">
                        <parameter key="define_connection" value="repository"/>
                        <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                        <parameter key="database_system" value="MySQL"/>
                        <parameter key="define_query" value="query"/>
                        <parameter key="query" value="WITH LastRows AS (&#10;&#10;    SELECT TOP 1 *&#10;&#10;    FROM sub_model_retraining_history&#10;&#10;    WHERE sub_model_version_id = %{sub_model_version_id}&#10;&#10;    ORDER BY sub_model_retraining_history_id DESC&#10;&#10;),&#10;&#10;LastSuccessful AS (&#10;&#10;    SELECT TOP 1 *&#10;&#10;    FROM sub_model_retraining_history&#10;&#10;    WHERE sub_model_version_id = %{sub_model_version_id}&#10;&#10;      AND retraining_status = 'successfull'&#10;&#10;    ORDER BY sub_model_retraining_history_id DESC&#10;&#10;)&#10;&#10;SELECT * &#10;&#10;FROM LastRows&#10;&#10;UNION ALL&#10;&#10;SELECT * &#10;&#10;FROM LastSuccessful&#10;&#10;WHERE EXISTS (&#10;&#10;    SELECT 1 FROM LastRows WHERE retraining_status = 'skipped'&#10;&#10;)&#10;&#10;ORDER BY sub_model_retraining_history_id DESC;&#10;&#10; "/>
                        <parameter key="use_default_schema" value="true"/>
                        <parameter key="prepare_statement" value="true"/>
                        <enumeration key="parameters"/>
                        <parameter key="data_management" value="auto"/>
