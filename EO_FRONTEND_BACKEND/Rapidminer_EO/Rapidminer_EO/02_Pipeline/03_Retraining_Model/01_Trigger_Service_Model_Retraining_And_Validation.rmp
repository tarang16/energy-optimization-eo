                            <list key="function_descriptions">
                              <parameter key="ideal_end_time" value="date_str_custom(date_add(date_parse_custom(%{last_end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),rint(parse(replace(%{validation_frequency},&quot;d&quot;,&quot;&quot;))),DATE_UNIT_DAY),&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
                              <parameter key="new_start_time" value="date_str_custom(date_add(date_parse_custom(%{last_end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),rint(1),DATE_UNIT_HOUR),&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
                              <parameter key="new_end_time" value="if(rint(date_diff(date_parse_custom(%{ideal_end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),&#10;date_add(date_parse_custom(%{last_retraining_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),rint(parse(replace(%{retrain_frequency},&quot;d&quot;,&quot;&quot;))),DATE_UNIT_DAY)))/(1000*60*60*24)&gt;=0,&#10;%{ideal_end_time},date_str_custom(date_add(date_parse_custom(%{last_retraining_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),rint(parse(replace(%{retrain_frequency},&quot;d&quot;,&quot;&quot;))),DATE_UNIT_DAY),&quot;yyyy-MM-dd HH:mm:ss&quot;))"/>
                              <parameter key="diff_new_end_time_new_start_time" value="concat(str(rint(date_diff(date_parse_custom(%{new_start_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),date_parse_custom(%{new_end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;)))/(1000*60*60)),&quot;h&quot;)"/>
                              <parameter key="diff_new_end_time_availablie_pi_time" value="rint(date_diff(date_parse_custom(%{new_end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),date_parse_custom(%{available_pi_time},&quot;yyyy-MM-dd HH:mm:ss&quot;)))/(1000*60*60*24)"/>
                              <parameter key="diff_new_end_time_time_now" value="rint(date_diff(date_parse_custom(%{new_end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),date_now()))/(1000*60*60*24)"/>
                              <parameter key="flag_validation" value="if((parse(%{diff_new_end_time_availablie_pi_time})&gt;=0 &amp;&amp; &#13;&#10;&#13;&#10;parse(replace(%{diff_new_end_time_new_start_time},&quot;h&quot;,&quot;&quot;))&gt;=0 &amp;&amp; &#13;&#10;%{last_retraining_status}==&quot;successfull&quot; &amp;&amp; parse(%{diff_new_end_time_time_now})&gt;=0),&#13;&#10;1,0)"/>
