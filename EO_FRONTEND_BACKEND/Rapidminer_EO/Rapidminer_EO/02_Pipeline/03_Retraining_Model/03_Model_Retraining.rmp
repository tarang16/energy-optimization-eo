                <parameter key="connection_entry" value="%{connection_sql_eo}"/>
                <parameter key="database_system" value="MySQL"/>
                <parameter key="define_query" value="query"/>
                <parameter key="query" value="SELECT mt.model_id FROM sub_model sm&#10;inner join model_tag mt&#10;on mt.model_tag_id = sm.target_model_tag_id&#10;where sm.active = 1 and sm.sub_model_id = %{sub_model_id}&#10;&#10;"/>
