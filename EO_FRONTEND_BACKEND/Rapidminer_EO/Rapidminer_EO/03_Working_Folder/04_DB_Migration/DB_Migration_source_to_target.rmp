              <operator activated="true" class="retrieve" compatibility="10.4.003" expanded="true" height="68" name="Retrieve Email Alerts" width="90" x="179" y="187">
                <parameter key="repository_entry" value="/Connections/Email Alerts"/>
              </operator>
              <operator activated="true" class="concurrency:loop_values" compatibility="10.4.003" expanded="true" height="103" name="loop_email_id" width="90" x="313" y="85">
                <parameter key="attribute" value="email_id"/>
                <parameter key="iteration_macro" value="loop_email_id"/>
                <parameter key="reuse_results" value="false"/>
                <parameter key="enable_parallel_execution" value="true"/>
                <process expanded="true">
                  <operator activated="true" class="handle_exception" compatibility="10.4.003" expanded="true" height="82" name="Handle Exception (2)" width="90" x="179" y="34">
                    <parameter key="exception_macro" value="error"/>
                    <parameter key="add_details_to_log" value="false"/>
                    <process expanded="true">
                      <operator activated="true" class="send_mail_attachments" compatibility="10.4.003" expanded="true" height="82" name="Send Mail (2)" width="90" x="313" y="34">
                        <parameter key="to" value="%{loop_email_id}"/>
                        <parameter key="subject" value="DB Migration from %{source_env} to %{target_env} Report "/>
                        <parameter key="use_html" value="true"/>
                        <parameter key="body_plain" value="Hello this is test Email"/>
                        <parameter key="body_html" value="&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;en&quot;&gt;&#10;&lt;head&gt;&#10;    &lt;meta charset=&quot;UTF-8&quot;&gt;&#10;    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;    &lt;title&gt;Process Information&lt;/title&gt;&#10;    &lt;style&gt;&#10;        /* Style from the first HTML file */&#10;        #table1 {&#10;            width: 100%;&#10;            font-family: &quot;SABIC Typeface Text&quot;;&#10;            color: #4D4D4D;&#10;            font-size: 11px;&#10;        }&#10;&#10;        #table1 th, #table1 td {&#10;            border: 1px solid black;&#10;            padding: 8px;&#10;            text-align: center;&#10;            font-weight: bold;&#10;            text-transform: uppercase;&#10;        }&#10;&#10;        .background-grey {&#10;            background-color: #009FDF;&#10;            color: #FFFFFF; /* Default font color */&#10;        }&#10;&#10;        .live {&#10;            color: #009FDF;&#10;        }&#10;&#10;        .backfilling {&#10;            color: #FFA300;&#10;        }&#10;&#10;        .error {&#10;            color: #E35205;&#10;        }&#10;&#10;        /* Style from the second HTML file */&#10;        .font_text {&#10;            font-family: &quot;SABIC Typeface Headline&quot;;&#10;            font-size: 12px;&#10;        }&#10;        }&#10;&#10;        #table2 {&#10;            width: 100%;&#10;            font-family: &quot;SABIC Typeface Text&quot;;&#10;            color: #4D4D4D;&#10;        }&#10;&#10;        .table_header {&#10;            font-size: 11px;&#10;            font-family: &quot;SABIC Typeface Headline&quot;;&#10;            color: #FFFFFF;&#10;            background-color: #009FDF;&#10;        }&#10;&#10;        .table_row {&#10;            font-size: 11px;&#10;            font-family: &quot;SABIC Typeface Headline&quot;;&#10;            color: #4D4D4D;&#10;        }&#10;&#10;        #table2,&#10;        #table2 tr,&#10;        #table2 td,&#10;        #table2 th {&#10;            border: 1px solid #939598;&#10;            border-collapse: collapse;&#10;            overflow-wrap: break-word;&#10;        }&#10;&#10;        #table2 th,&#10;        #table2 td {&#10;            padding: 0.5% 0.5%;&#10;        }&#10;&#10;        .text_align_left {&#10;            text-align: left;&#10;            min-inline-size: 100px;&#10;        }&#10;&#10;        .text_align_center {&#10;            text-align: center;&#10;            min-inline-size: 100px;&#10;        }&#10;&#10;        .text_align_center_red {&#10;            text-align: center;&#10;            color: #E35205;&#10;            min-inline-size: 100px;&#10;        }&#10;&#10;        .text_align_center_cyan {&#10;            text-align: center;&#10;            color: #009FDF;&#10;            min-inline-size: 100px;&#10;        }&#10;&#10;        .text_align_center_orange {&#10;            text-align: center;&#10;            color: #FFA300;&#10;            min-inline-size: 100px;&#10;        }&#10;&#10;        .error_detail {&#10;            overflow-wrap: normal;&#10;            min-inline-size: 175px;&#10;        }&#10;        .font_h3 {&#10;            margin-top: 20px; /* Adjust the value as needed */&#10;            margin-bottom: 20px;             &#10;            font-family: &quot;SABIC Typeface Headline&quot;;&#10;            font-size: 16px;&#10;        }&#10;        .footer {&#10;            background-color: #009FDF;&#10;            text-align: center;&#10;        }&#10;    &lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;    &lt;div&gt;&#10;        &lt;p class=&quot;font_text&quot;&gt;Team,&lt;/p&gt;&#10;        &lt;p class=&quot;font_text&quot;&gt;Please find the DB Migration from %{source_env} to %{target_env} report.&lt;/p&gt;&#10;        &lt;p class=&quot;font_text&quot;&gt;Last Updated : %{time_current}&lt;/p&gt;&#10;        &lt;h3 class=&quot;font_h3&quot;&gt;Summary:&lt;/h3&gt;&#10;       &#10;    &lt;/div&gt;&#10; &#10;        &lt;h3 class=&quot;font_h3&quot;&gt;Report:&lt;/h3&gt;&#10;        &lt;table id=&quot;table2&quot;&gt;&#10;                    &lt;thead&gt;&#10;                        &lt;tr class=&quot;table_header&quot;&gt;&#10;                            &lt;th&gt;CASE ID&lt;/th&gt;&#10;                            &lt;th&gt;TABLE TYPE&lt;/th&gt;&#10;                            &lt;th&gt;REMARKS&lt;/th&gt;&#10;                        &lt;/tr&gt;&#10;                    &lt;/thead&gt;&#10;                    &lt;tbody&gt;&#10;                    &#9; %{html_email_body}&#10;                    &lt;/tbody&gt;&#10;       &lt;/table&gt;&#10;      &lt;p&gt;Thank you&lt;/p&gt;&#10;      &lt;p &gt;&#10;          &lt;span&#10;            style=&quot;&#10;              font-size: 8.5pt;&#10;              font-family: 'SABIC Typeface Text', sans-serif;&#10;              &#10;              color: #e35205;&#10;            &quot;&#10;            &gt;This is an automatically generated notification.&#10;            Please do not reply to this mail address. &lt;o:p&gt;&lt;/o:p&#10;          &gt;&lt;/span&gt;&#10;      &lt;/p&gt;&#10;   &lt;/div&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;"/>
                        <list key="filenames"/>
                        <list key="headers"/>
                      </operator>
                      <connect from_port="in 1" to_op="Send Mail (2)" to_port="connection"/>
                      <portSpacing port="source_in 1" spacing="0"/>
                      <portSpacing port="source_in 2" spacing="0"/>
                      <portSpacing port="sink_out 1" spacing="0"/>
                    </process>
                    <process expanded="true">
                      <operator activated="true" class="print_to_console" compatibility="10.4.003" expanded="true" height="68" name="Print to Console" width="90" x="380" y="34">
                        <parameter key="log_value" value="%{error}"/>
                      </operator>
                      <portSpacing port="source_in 1" spacing="0"/>
                      <portSpacing port="source_in 2" spacing="0"/>
                      <portSpacing port="sink_out 1" spacing="0"/>
                    </process>
                  </operator>
                  <connect from_port="input 2" to_op="Handle Exception (2)" to_port="in 1"/>
                  <portSpacing port="source_input 1" spacing="0"/>
                  <portSpacing port="source_input 2" spacing="0"/>
                  <portSpacing port="source_input 3" spacing="0"/>
                  <portSpacing port="sink_output 1" spacing="0"/>
                </process>
              </operator>
              <connect from_op="data_list_email_id" from_port="result" to_op="loop_email_id" to_port="input 1"/>
              <connect from_op="Retrieve Email Alerts" from_port="output" to_op="loop_email_id" to_port="input 2"/>
              <portSpacing port="source_in 1" spacing="0"/>
              <portSpacing port="sink_out 1" spacing="0"/>
            </process>
          </operator>
          <connect from_port="in 1" to_op="generate_dynamic_html" to_port="in 1"/>
          <portSpacing port="source_in 1" spacing="0"/>
          <portSpacing port="source_in 2" spacing="0"/>
          <portSpacing port="sink_out 1" spacing="0"/>
          <portSpacing port="sink_out 2" spacing="0"/>
        </process>
      </operator>
      <connect from_op="static_tables (4)" from_port="input 1" to_op="prepare_output" to_port="in 1"/>
      <connect from_op="ccp_table" from_port="input 1" to_op="prepare_output" to_port="in 4"/>
      <connect from_op="CleanData_tables (3)" from_port="input 1" to_op="prepare_output" to_port="in 2"/>
      <connect from_op="output_tables (2)" from_port="input 1" to_op="prepare_output" to_port="in 3"/>
      <connect from_op="prepare_output" from_port="out 1" to_op="Subprocess (2)" to_port="in 1"/>
      <connect from_op="Subprocess (2)" from_port="out 1" to_op="active cases (2)" to_port="condition"/>
      <connect from_op="active cases (2)" from_port="input 1" to_op="Response Emailer" to_port="in 1"/>
      <connect from_op="Response Emailer" from_port="out 1" to_port="result 1"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
    </process>
  </operator>
</process>
