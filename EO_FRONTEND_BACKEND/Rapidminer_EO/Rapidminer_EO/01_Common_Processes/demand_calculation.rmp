              <description align="center" color="transparent" colored="true" height="85" resized="true" width="218" x="315" y="113">sub_model_name&lt;br&gt;sub_model_id&lt;br&gt;sub_model_type&lt;br&gt;sub_model_expression</description>
            </process>
            <description align="center" color="transparent" colored="false" width="126">I/P 1: sub model&lt;br&gt;I/P 2: sub model child&lt;br&gt;I/P 3: user_input&lt;br&gt;&lt;br&gt;O/P 1: Sub model&lt;br&gt;O/P 2: submodel values(Demands)</description>
