              <connect from_port="input 3" to_op="Demand calculation" to_port="input 1"/>
              <connect from_op="Extract Macro" from_port="example set" to_port="output 1"/>
              <connect from_op="Demand calculation" from_port="input 1" to_port="output 2"/>
              <connect from_op="Demand calculation" from_port="input 2" to_port="output 3"/>
              <portSpacing port="source_input 1" spacing="0"/>
              <portSpacing port="source_input 2" spacing="0"/>
              <portSpacing port="source_input 3" spacing="0"/>
