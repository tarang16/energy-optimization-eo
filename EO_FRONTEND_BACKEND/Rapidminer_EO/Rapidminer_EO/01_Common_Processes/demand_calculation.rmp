      </operator>
      <connect from_port="input 1" to_op="Main" to_port="in 1"/>
      <connect from_port="input 2" to_op="Main" to_port="in 2"/>
      <connect from_port="input 3" to_op="Main" to_port="in 3"/>
      <connect from_op="Main" from_port="out 1" to_port="result 1"/>
      <connect from_op="Main" from_port="out 2" to_port="result 2"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="source_input 2" spacing="0"/>
      <portSpacing port="source_input 3" spacing="0"/>
      <portSpacing port="source_input 4" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
      <portSpacing port="sink_result 3" spacing="0"/>
      <description align="center" color="green" colored="true" height="512" resized="true" width="278" x="12" y="38">Demand Calculation&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;Author:&lt;br&gt;Trupti jadhav&lt;br&gt;Akshay Hasabe&lt;br&gt;Karthik Sanagapalli&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;Overview:&lt;br&gt;In this process, the demand is calculated by leveraging a sub-model or a sub-model expression. This sub-model utilizes various plant parameters that are provided by the user through an interactive dashboard. These inputs allow the system to dynamically compute the demand based on the specific conditions and configurations defined by the user.&lt;br&gt;</description>
      <description align="center" color="purple" colored="true" height="512" resized="true" width="423" x="291" y="38">MAIN</description>
    </process>
