            <parameter key="input_csv_text" value="macro_name, macro_value&#10;available_pi_time, %{available_pi_time}&#10;last_run_time, %{last_run_time}&#10;need_to_run_flag, %{need_to_run_flag}&#10;pullpi_window_hour, %{pullpi_window_hour}h&#10;frequency,%{frequency}&#10;ts_check_log,%{error_ts_check}"/>
            <parameter key="column_separator" value=","/>
            <parameter key="parse_all_as_nominal" value="false"/>
            <parameter key="decimal_point_character" value="."/>
            <parameter key="trim_attribute_names" value="true"/>
            <description align="center" color="transparent" colored="false" width="126">Creating ExampleSet to show the results for available pi time tag, last run time, need to run flag, pullpi window hour, frequency and logs</description>
          </operator>
          <connect from_port="in 1" to_op="get timestamps for all check_tags" to_port="in 1"/>
          <connect from_op="get timestamps for all check_tags" from_port="out 1" to_op="need to run flag" to_port="in 1"/>
          <connect from_op="Create ExampleSet (6)" from_port="output" to_port="out 1"/>
          <portSpacing port="source_in 1" spacing="0"/>
          <portSpacing port="source_in 2" spacing="0"/>
          <portSpacing port="sink_out 1" spacing="0"/>
          <portSpacing port="sink_out 2" spacing="0"/>
        </process>
        <description align="center" color="transparent" colored="false" width="126">Calculating available pi time tag, last run time, need to run flag, pullpi window hour and frequency</description>
      </operator>
      <connect from_port="input 1" to_op="initialization (2)" to_port="in 1"/>
      <connect from_op="initialization (2)" from_port="out 1" to_op="main (2)" to_port="in 1"/>
      <connect from_op="main (2)" from_port="out 1" to_port="result 1"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="source_input 2" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
      <description align="center" color="blue" colored="true" height="613" resized="true" width="276" x="379" y="13">FE Initialization</description>
      <description align="center" color="green" colored="true" height="607" resized="true" width="303" x="657" y="18">Main</description>
      <description align="center" color="red" colored="true" height="612" resized="true" width="367" x="10" y="13">Data availability check&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;Author:&lt;br&gt;Akshay Hasabe&lt;br&gt;Naveen Kumar&lt;br&gt;Karthik Sanagapalli&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;Overview:&lt;br&gt;This process is a common process which reads the last run time of certain case along with latest data available in PI for that specific plant based on PI Tag provided in config file and determines the next possible new run time for which the trigger service would generate output.&lt;br&gt;Input macro&lt;br&gt;1. Connection sql&lt;br&gt;2. Connection pi&lt;br&gt;3. case_id&lt;br&gt;4. pullpi_window_hour&lt;br&gt;&lt;br&gt;Output:&lt;br&gt;Dataframe containing available_pi_time, last_run_time,&lt;br&gt;need_to_run_flag,&lt;br&gt;pullpi_window_hour, frequency</description>
      <description align="center" color="transparent" colored="true" height="192" resized="false" width="126" x="696" y="372">example set with columns 'macro_name' &amp;amp; 'macro_value'.&lt;br&gt;Please run 'Set macro from example set' on this output to get the macros 'need_to_run_flag'</description>
    </process>
  </operator>
</process>
