                      <portSpacing port="sink_out 1" spacing="0"/>
                    </process>
                    <description align="center" color="transparent" colored="false" width="126">gen pi name &amp;amp; it's macro combo</description>
                  </operator>
                  <operator activated="true" class="generate_attributes" compatibility="10.4.003" expanded="true" height="82" name="Generate Attributes (25)" width="90" x="45" y="187">
                    <list key="function_descriptions">
                      <parameter key="id" value="str(ceil([id]/parse(%{time_splitter})))"/>
                    </list>
                    <parameter key="keep_all" value="true"/>
                    <description align="center" color="transparent" colored="false" width="126">gen timeseries batches based on time split</description>
                  </operator>
                  <operator activated="true" class="concurrency:loop_values" compatibility="10.4.003" expanded="true" height="103" name="Loop Values (6)" width="90" x="179" y="187">
                    <parameter key="attribute" value="id"/>
