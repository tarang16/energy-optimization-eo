              </operator>
              <operator activated="true" class="generate_macro" compatibility="10.4.003" expanded="true" height="68" name="Generate Macro (3)" width="90" x="447" y="136">
                <list key="function_descriptions">
                  <parameter key="hour_value" value="replaceAll(%{pullpi_window_hour},&quot;[h]&quot;,&quot;&quot;)"/>
                  <parameter key="day_unit" value="replaceAll(%{pullpi_window_day},&quot;[0-9]&quot;,&quot;&quot;)"/>
                  <parameter key="timeinterval_suffix" value="replaceAll(%{pullpi_timeinterval},&quot;[0-9]&quot;,&quot;&quot;)"/>
                  <parameter key="day_value" value="replaceAll(%{pullpi_window_day},&quot;[dhmM]&quot;,&quot;&quot;)"/>
                  <parameter key="timeinterval_prefix" value="replaceAll(%{pullpi_timeinterval},&quot;[dhm]&quot;,&quot;&quot;)"/>
                </list>
                <description align="center" color="transparent" colored="false" width="126">gen macros to find units &amp;amp; values of existing macros</description>
              </operator>
              <operator activated="true" class="generate_macro" compatibility="10.4.003" expanded="true" height="68" name="Generate Macro (15)" width="90" x="581" y="136">
                <list key="function_descriptions">
                  <parameter key="time_start" value="date_str_custom(date_add(date_parse_custom(%{end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),0-rint(parse(replace(%{pullpi_window_day},&quot;d&quot;,&quot;&quot;))),DATE_UNIT_DAY),&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
                  <parameter key="time_end" value="date_str_custom(date_add(date_parse_custom(%{end_time},&quot;yyyy-MM-dd HH:mm:ss&quot;),rint(parse(%{hour_value})),DATE_UNIT_HOUR),&quot;yyyy-MM-dd HH:mm:ss&quot;)"/>
                  <parameter key="time_diff" value="rint(date_diff(date_parse_custom(%{time_start},&quot;yyyy-MM-dd HH:mm:ss&quot;),date_parse_custom(%{time_end},&quot;yyyy-MM-dd HH:mm:ss&quot;))/(1000*60))"/>
                  <parameter key="time_diff" value="if(%{timeinterval_suffix}==&quot;h&quot;,ceil(parse(%{time_diff})/(parse(%{timeinterval_prefix})*60)),if(%{timeinterval_suffix}==&quot;d&quot;,ceil(parse(%{time_diff})/(parse(%{timeinterval_prefix})*60*24)),if(%{timeinterval_suffix}==&quot;m&quot;,ceil(parse(%{time_diff})/(parse(%{timeinterval_prefix}))),&quot;error&quot;)))"/>
                  <parameter key="time_shift_unit" value="if(%{timeinterval_suffix}==&quot;d&quot;,DATE_UNIT_DAY,&#10;if(%{timeinterval_suffix}==&quot;h&quot;,DATE_UNIT_HOUR,&#10;if(%{timeinterval_suffix}==&quot;m&quot;,DATE_UNIT_MINUTE,1)))"/>
