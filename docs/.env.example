# ===================================================================
# DB connection settings for db_writer.py
# Copy this file to `.env` and fill in your values. .env is gitignored.
# ===================================================================

# SQL Server hostname (with \instance if using a named instance)
#   examples: localhost, prod-sql01.corp.local, prod-sql\SQLEXPRESS
DB_SERVER=

# Database name. Default matches the existing project DB.
DB_NAME=SABIC_DT_EnergyOptimization

# ODBC driver name as installed on this machine.
#   - "ODBC Driver 17 for SQL Server" (most common)
#   - "ODBC Driver 18 for SQL Server" (newer; default-encrypts)
#   Run `odbcad32.exe` (or `Get-OdbcDriver` in PowerShell) to see installed drivers.
DB_DRIVER=ODBC Driver 17 for SQL Server

# Auth — leave both blank to use Windows authentication (Trusted_Connection).
# If using SQL auth, fill both.
DB_USER=
DB_PASSWORD=
